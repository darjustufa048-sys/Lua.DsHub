local SAVE_PATH = "DsHub_Duels_Config.json"
local function saveSettings()
	pcall(function()
		local data = {}
		for k, v in pairs(cfg) do data[k] = v end
		writefile(SAVE_PATH, HttpService:JSONEncode(data))
	end)
end
local function loadSettings()
	pcall(function()
		if isfile and isfile(SAVE_PATH) then
			local data = HttpService:JSONDecode(readfile(SAVE_PATH))
			for k, v in pairs(data) do if cfg[k] ~= nil then cfg[k] = v end end
		end
	end)
end
