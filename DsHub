local tauntCD = false
local function doTaunt()
	if tauntCD then return end
	tauntCD = true
	task.spawn(function()
		for i = 1, 5 do
			pcall(function()
				local sent = false
				if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
					local chs = TextChatService:FindFirstChild("TextChannels")
					if chs then
						local g = chs:FindFirstChild("RBXGeneral")
						if g then g:SendAsync("/DS"); sent = true end
					end
					if not sent then
						for _, ch in ipairs(TextChatService:GetDescendants()) do
							if ch:IsA("TextChannel") then ch:SendAsync("/DS"); sent = true; break end
						end
					end
				end
				if not sent then
					local rs = game:GetService("ReplicatedStorage")
					local re = rs:FindFirstChild("SayMessageRequest")
					if re and re:IsA("RemoteEvent") then re:FireServer("/DS","All"); sent = true end
					if not sent then
						for _, v in ipairs(rs:GetDescendants()) do
							if v:IsA("RemoteEvent") and (v.Name:lower():find("say") or v.Name:lower():find("chat") or v.Name:lower():find("message")) then
								v:FireServer("/DS","All"); break
							end
						end
					end
				end
			end)
			task.wait(0.1)
		end
		task.wait(2)
		tauntCD = false
	end)
end

