local function mkMiniEx(specs)
	local n = #specs
	local totalH = MM_HR + MM_PD + n*(MM_BH+MM_GP) - MM_GP + MM_PD
	local frame = Instance.new("Frame", gui)
	frame.Size = UDim2.new(0,MM_W,0,totalH)
	frame.Position = UDim2.new(0,0,0,0)
	frame.BackgroundColor3 = C_PANEL; frame.BorderSizePixel = 0
	frame.ZIndex = 60; frame.Active = true; frame.Visible = false
	corner(frame,10); stroke(frame)

	local hdr = Instance.new("Frame", frame)
	hdr.Size = UDim2.new(1,0,0,MM_HR)
	hdr.BackgroundColor3 = C_BTN; hdr.BorderSizePixel = 0; hdr.ZIndex = 61
	corner(hdr,10)
	local gearL = lbl(hdr,"⚙",14,C_DIM,Enum.TextXAlignment.Left,62)
	gearL.Size = UDim2.new(0,20,1,0); gearL.Position = UDim2.new(0,8,0,0)
	local dotsL = lbl(hdr,"· · ·",12,C_OFF,Enum.TextXAlignment.Center,62)
	dotsL.Size = UDim2.new(1,-28,1,0); dotsL.Position = UDim2.new(0,20,0,0)
	makeDrag(frame, hdr)

	local refs = {}
	for i, sp in ipairs(specs) do
		local yp = MM_HR + MM_PD + (i-1)*(MM_BH+MM_GP)
		if sp.type == "num" then
			local row = Instance.new("Frame", frame)
			row.Size = UDim2.new(1,-MM_PD*2,0,MM_BH)
			row.Position = UDim2.new(0,MM_PD,0,yp)
			row.BackgroundColor3 = C_BTN; row.BorderSizePixel = 0; row.ZIndex = 62
			corner(row,7); stroke(row,C_BORDER,1)
			local lbL = lbl(row,sp.label,12,C_DIM,Enum.TextXAlignment.Left,63)
			lbL.Size = UDim2.new(1,0,0,16); lbL.Position = UDim2.new(0,6,0,2)
			local dec = Instance.new("TextButton",row)
			dec.Size = UDim2.new(0,26,0,22); dec.Position = UDim2.new(0,4,1,-26)
			dec.BackgroundTransparency = 1; dec.Text = "◄"; dec.TextColor3 = C_DIM
			dec.Font = BIF; dec.TextSize = 15; dec.ZIndex = 63
			local valL = lbl(row, tostring(sp.getVal()), 14, C_ON, Enum.TextXAlignment.Center, 63)
			valL.Size = UDim2.new(1,-60,0,22); valL.Position = UDim2.new(0,30,1,-26)
			local inc = Instance.new("TextButton",row)
			inc.Size = UDim2.new(0,26,0,22); inc.Position = UDim2.new(1,-30,1,-26)
			inc.BackgroundTransparency = 1; inc.Text = "►"; inc.TextColor3 = C_DIM
			inc.Font = BIF; inc.TextSize = 15; inc.ZIndex = 63
			local function ref() valL.Text = tostring(sp.getVal()) end
			dec.MouseButton1Click:Connect(function() sp.setVal(math.max(sp.min,sp.getVal()-sp.step)); ref() end)
			inc.MouseButton1Click:Connect(function() sp.setVal(math.min(sp.max,sp.getVal()+sp.step)); ref() end)
			refs[sp.id] = {row=row, valL=valL}
		else
			local btn = Instance.new("TextButton",frame)
			btn.Size = UDim2.new(1,-MM_PD*2,0,MM_BH)
			btn.Position = UDim2.new(0,MM_PD,0,yp)
			btn.BackgroundColor3 = C_BTN; btn.BorderSizePixel = 0
			btn.Text = sp.label; btn.TextColor3 = C_DIM
			btn.Font = BIF; btn.TextSize = 16; btn.ZIndex = 62
			corner(btn,7); stroke(btn,C_BORDER,1)
			if sp.fn then btn.MouseButton1Click:Connect(sp.fn) end
			refs[sp.id] = btn
		end
	end
	return frame, refs
end

