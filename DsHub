	if y + mh > vp.Y - 4 then y = ab.Y - mh - 4 end
	x = math.clamp(x, 4, vp.X - mw - 4)
	menu.Position = UDim2.new(0,x,0,y)
end

local function wire(mainBtn, menu)
	mainBtn.MouseButton1Click:Connect(function()
		menu.Visible = not menu.Visible
		if menu.Visible then posMenu(menu, mainBtn) end
	end)
end

