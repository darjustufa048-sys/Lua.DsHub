	decBtn.BackgroundTransparency = 1; decBtn.Text = "◄"
	decBtn.TextColor3 = C_DIM; decBtn.Font = BIF; decBtn.TextSize = 14; decBtn.ZIndex = 34
	
	local valL = lbl(row, tostring(getV()), 13, C_ON, Enum.TextXAlignment.Center, 33)
	valL.Size = UDim2.new(0,40,0,20); valL.Position = UDim2.new(0,104,0,4)
	
	local incBtn = Instance.new("TextButton",row)
	incBtn.Size = UDim2.new(0,20,0,20); incBtn.Position = UDim2.new(0,144,0,4)
	incBtn.BackgroundTransparency = 1; incBtn.Text = "►"
	incBtn.TextColor3 = C_DIM; incBtn.Font = BIF; incBtn.TextSize = 14; incBtn.ZIndex = 34
	
	local function update()
		valL.Text = tostring(getV())
	end
	
	decBtn.MouseButton1Click:Connect(function()
		setV(math.max(min, getV()-step))
		update()
	end)
	
	incBtn.MouseButton1Click:Connect(function()
		setV(math.min(max, getV()+step))
		update()
	end)
	
	return row
end

